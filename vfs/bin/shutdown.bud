
/**
 * The shutdown command source code.
 */
export const shutdown = {
    description: 'Gracefully shuts down the entire Hexley instance.',
    extendedDescription: 'This command will cleanly disconnect frameworks and modules to exit the main process.',

    /**
     * Main entry point for the exit command.
     * @param {any} Hexley - The main Hexley global object.
     * @param {string[]} args - The arguments passed to the command.
     */
    async main(Hexley: any, args: string[]) {
        await Hexley.frameworks.hexShell.shutdownGracefully(Hexley);
    }
    
};
