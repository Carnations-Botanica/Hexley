import { EmbedBuilder, MessageFlags } from 'discord.js';

/**
 * The dext command source code.
 */
export const dext = {
    description: 'Interfaces with the Discord Framework to issue commands and list information.',
    extendedDescription: 'Use `dext [action]` to make Discord Framework requests.\nActions:\n  list - Lists all slash commands.\n  remove [commandId] - Removes a slash command by its ID.\n  deregisterAll [confirm] - Removes all registered slash commands (requires \'confirm\' argument).\n  phonebook - Lists all channels in the guild, sorted by category.\n  create <commandName> "<description>" - Creates a new slash command.\n  ids <type> - Lists all loaded IDs of a given type (roles, channels, users).\n  usercolor <userId> - Fetches the color of a user\'s highest role.\n  say <modifier> <args> - Sends a message (standard text or rich embed).\n    - standard <channelId> <message...> - Sends a plain text message.\n    - embedded <channelId> [imageName] "<title>" "<description>" [footer] - Sends an embed.',

    /**
     * Predetermined map of image names to GitHub assets.
     * This supports adding your own, for your own Core personality.
     */
    IMAGE_ASSETS: {
        hexleyBare: 'https://raw.githubusercontent.com/Carnations-Botanica/assets/refs/heads/main/Hexley/assets/hexley_bare.png',
        hexleyCarnations: 'https://raw.githubusercontent.com/Carnations-Botanica/assets/refs/heads/main/Hexley/assets/hexley_carnations.png',
        hexleyFork: 'https://raw.githubusercontent.com/Carnations-Botanica/assets/refs/heads/main/Hexley/assets/hexley_fork.png',
        hexleyGlobe: 'https://raw.githubusercontent.com/Carnations-Botanica/assets/refs/heads/main/Hexley/assets/hexley_globe.png',
        hexleyKey: 'https://raw.githubusercontent.com/Carnations-Botanica/assets/refs/heads/main/Hexley/assets/hexley_key.png',
        hexleyPackage: 'https://raw.githubusercontent.com/Carnations-Botanica/assets/refs/heads/main/Hexley/assets/hexley_package.png',
        hexleySits: 'https://raw.githubusercontent.com/Carnations-Botanica/assets/refs/heads/main/Hexley/assets/hexley_sits.png',
        hexleyWorm: 'https://raw.githubusercontent.com/Carnations-Botanica/assets/refs/heads/main/Hexley/assets/hexley_worm.png',
    } as { [key: string]: string },

    /**
     * Helper to strip quotes from a string argument.
     */
    _stripQuotes(arg: string): string {
        return arg.startsWith('"') && arg.endsWith('"') ? arg.slice(1, -1) : arg;
    },

    /**
     * Finds and joins arguments that form a quoted block, starting from the given index.
     * @param {string[]} args - The full array of command line arguments.
     * @param {number} startIndex - The index to start searching for the opening quote.
     * @returns {{ value: string, index: number }} The reconstructed raw string and the index after the block.
     */
    _extractQuotedBlock(args: string[], startIndex: number): { value: string, index: number } {
        let currentBlock: string[] = [];
        let blockStartIndex = -1;
        let blockEndIndex = -1;

        // Find the starting quote index
        for (let i = startIndex; i < args.length; i++) {
            if (args[i].startsWith('"')) {
                blockStartIndex = i;
                break;
            }
        }

        if (blockStartIndex === -1) {
            // If no quote is found, treat the argument as a single non-quoted word.
            return { value: args[startIndex] || '', index: startIndex + 1 };
        }
        
        // Find the closing quote index
        for (let i = blockStartIndex; i < args.length; i++) {
            currentBlock.push(args[i]);
            if (args[i].endsWith('"')) {
                blockEndIndex = i;
                break;
            }
        }

        // Reconstruct and return
        const rawValue = currentBlock.join(' ');
        
        return {
            value: rawValue,
            index: blockEndIndex !== -1 ? blockEndIndex + 1 : args.length
        };
    },

    /**
     * Main entry point for the dext command.
     * @param {any} Hexley - The main Hexley global object.
     * @param {string[]} args - The arguments passed to the command.
     */
    async main(Hexley: any, args: string[]) {
        if (args.length === 0) {
            console.log('dext: missing action operand');
            return;
        }

        const action = args[0];

        if (!Hexley.discordLoaded) {
            console.log('dext: Discord framework is not loaded.');
            return;
        }

        switch (action) {
            case 'list':
                await Hexley.frameworks.discord.listSlashCommands(Hexley);
                break;
            case 'remove':
                if (args.length < 2) {
                    console.log('dext: missing commandId for remove action');
                    return;
                }
                const commandId = args[1];
                const success = await Hexley.frameworks.discord.removeSlashCommand(Hexley, commandId);
                if (success) {
                    console.log(`Successfully removed slash command with ID: ${commandId}`);
                } else {
                    console.log(`Failed to remove slash command with ID: ${commandId}`);
                }
                break;

            case 'deregisterAll':
                if (args.length < 2 || args[1] !== 'confirm') {
                    console.log('dext: Danger! To deregister ALL slash commands, you must provide the "confirm" argument.');
                    console.log('Usage: dext deregisterAll confirm');
                    return;
                }
                console.log('Initiating mass deregistration of slash commands...');
                const deregisteredCount = await Hexley.frameworks.discord.deregisterAllSlashCommands(Hexley);
                if (deregisteredCount !== null && deregisteredCount >= 0) {
                    console.log(`Successfully deregistered ${deregisteredCount} slash command(s).`);
                } else {
                    console.log(`Failed to deregister slash commands. Check logs for details.`);
                }
                break;

            case 'phonebook':
                const channelData = await Hexley.frameworks.discord.listChannels(Hexley);
                if (!channelData) {
                    console.log('dext: Could not retrieve channel data.');
                    return;
                }

                console.log(`Channels in Guild ${channelData.guild.name} (ID: ${channelData.guild.id}):`);

                // Print categorized channels
                channelData.categories.forEach((category: any) => {
                    console.log(Hexley.frameworks.aurora.colorText(`\n${category.name} - ${category.id}`, '#ADE1FF'));
                    category.textChannels.forEach((channel: any) => {
                        console.log(Hexley.frameworks.aurora.colorText(`  ${channel.name} - ${channel.id}`, '#ffE9AD'));
                    });
                    category.voiceChannels.forEach((channel: any) => {
                        console.log(Hexley.frameworks.aurora.colorText(`  ${channel.name} - ${channel.id}`, '#23E0AE'));
                    });
                });

                // Print ungrouped channels
                if (channelData.ungrouped.textChannels.length > 0) {
                    console.log(Hexley.frameworks.aurora.colorText('\nUngrouped Text Channels:', '#ADE1FF'));
                    channelData.ungrouped.textChannels.forEach((channel: any) => {
                        console.log(Hexley.frameworks.aurora.colorText(`  ${channel.name} - ${channel.id}`, '#ffE9AD'));
                    });
                }
                break;
            case 'create':
                if (args.length < 3) {
                    console.log('dext: missing arguments for create action');
                    return;
                }
                const commandName = args[1];
                const description = args.slice(2).join(' ').replace(/"/g, '');
                await Hexley.frameworks.discord.initBasicSlashCommand(Hexley, commandName, description, false);
                break;
            case 'ids':
                if (args.length < 2) {
                    console.log('dext: missing type for ids action');
                    return;
                }
                const type = args[1];
                if (Hexley.frameworks.discord.discordIds[type]) {
                    console.log(`${type} IDs:`);
                    console.table(Hexley.frameworks.discord.discordIds[type]);
                } else {
                    console.log(`dext: unknown id type '${type}'`);
                }
                break;
            case 'usercolor':
                if (args.length < 2) {
                    console.log('dext: missing userId for usercolor action');
                    return;
                }
                const userId = args[1];
                const member = await Hexley.frameworks.discord.getGuildMember(userId);
                if (member) {
                    const color = Hexley.frameworks.discord.getUserRoleColor(member);
                    const coloredUsername = Hexley.frameworks.aurora.colorText(member.user.tag, color);
                    const coloredHex = Hexley.frameworks.aurora.colorText(color, color);
                    console.log(`User ${coloredUsername}'s color is: ${coloredHex}`);
                } else {
                    console.log(`dext: could not find user with ID '${userId}'`);
                }
                break;
            
            case 'say':
                const modifier = args[1];
                if (!modifier) {
                    console.log('dext say: missing message modifier (standard or embedded).');
                    return;
                }

                if (modifier === 'standard') {
                    // Usage: dext say standard <channelId> <message...>
                    if (args.length < 3) {
                        console.log('dext say standard: Usage: dext say standard <channelId> <message...>');
                        return;
                    }
                    const channelId = args[2];
                    const messageContent = args.slice(3).join(' ');

                    if (!messageContent) {
                         console.log('dext say standard: message content cannot be empty.');
                         return;
                    }

                    const message = await Hexley.frameworks.discord.sendMessageToChannel(channelId, messageContent);
                    if (message) {
                        console.log(Hexley.frameworks.aurora.colorText(`Successfully sent standard message to channel ${channelId}.`, Hexley.frameworks.aurora.tintGreen));
                    } else {
                        console.log(Hexley.frameworks.aurora.colorText(`Failed to send message to channel ${channelId}.`, Hexley.frameworks.aurora.tintRed));
                    }
                    return;
                
                } else if (modifier === 'embedded') {
                    // Usage: dext say embedded <channelId> [imageName] "<title>" "<description>" [footer]
                    if (args.length < 5) {
                        console.log('dext say embedded: Usage: dext say embedded <channelId> <imageName|none> "<title>" "<description>" [footer|none]');
                        console.log('Note: <imageName> and [footer] must be provided as separate arguments; quotes are expected for title/description/footer.');
                        return;
                    }

                    const channelId = args[2];
                    const rawImageName = args[3];
                    let currentArgIndex = 4;

                    const titleBlock = this._extractQuotedBlock(args, currentArgIndex);
                    const rawTitle = titleBlock.value;
                    currentArgIndex = titleBlock.index;
                    const descBlock = this._extractQuotedBlock(args, currentArgIndex);
                    const rawDescription = descBlock.value;
                    currentArgIndex = descBlock.index;
                    const rawFooter = args.slice(currentArgIndex).join(' '); 
                    const title = this._stripQuotes(rawTitle);
                    const description = this._stripQuotes(rawDescription);
                    const footer = rawFooter ? this._stripQuotes(rawFooter) : undefined;
                    const imageKey = Object.keys(this.IMAGE_ASSETS).find(key => key.toLowerCase() === rawImageName.toLowerCase());
                    const imageUrl = imageKey ? this.IMAGE_ASSETS[imageKey] : undefined;

                    if (!title || !description) {
                         console.log(Hexley.frameworks.aurora.colorText('dext say embedded: Title and Description arguments must be provided in quotes.', Hexley.frameworks.aurora.tintRed));
                         return;
                    }
                    
                    if (rawImageName.toLowerCase() !== 'none' && !imageUrl) {
                        const availableImages = Object.keys(this.IMAGE_ASSETS).join(', ');
                        console.log(Hexley.frameworks.aurora.colorText(`dext say embedded: Unknown image name '${rawImageName}'. Available options are ${availableImages}`, Hexley.frameworks.aurora.tintRed));
                        return;
                    }

                    const embed = new EmbedBuilder()
                        .setTimestamp()
                        .setTitle(title)
                        .setDescription(description)
                        .setColor(Hexley.frameworks.aurora.tintRedBright);

                    if (imageUrl) {
                        embed.setThumbnail(imageUrl);
                    }
                    if (footer) {
                        embed.setFooter({ text: footer });
                    }

                    const message = await Hexley.frameworks.discord.sendMessageToChannel(channelId, { embeds: [embed] });

                    if (message) {
                        console.log(Hexley.frameworks.aurora.colorText(`Successfully sent embedded message to channel ${channelId}.`, Hexley.frameworks.aurora.tintGreen));
                    } else {
                        console.log(Hexley.frameworks.aurora.colorText(`Failed to send embedded message to channel ${channelId}.`, Hexley.frameworks.aurora.tintRed));
                    }
                    return;
                }
                
                // Fallthrough for unknown modifier
                console.log(`dext say: Unknown modifier '${modifier}'. Use 'standard' or 'embedded'.`);
                return;

            default:
                console.log(`dext: unknown action '${action}'`);
        }
    }
    
};
