import os from 'os';
import si from 'systeminformation';

// Function to format memory into GiB (Gibibytes)
function formatMemory(memoryInBytes: number): string {
    const bytesInGiB = 1024 * 1024 * 1024; // 1 GiB in bytes
    return (memoryInBytes / bytesInGiB).toFixed(2); // Format to 2 decimal places
}

// Function to get the local IP addresses
function getLocalIPAddresses() {
    const interfaces = os.networkInterfaces();
    let ipv4Addresses: string[] = [];
    let ipv6Addresses: string[] = [];

    for (const name in interfaces) {
        for (const iface of interfaces[name] || []) {
            if (iface.family === 'IPv4' && !iface.internal) {
                ipv4Addresses.push(iface.address);
            }
            // Ignore link-local addresses (starting with fe80)
            if (iface.family === 'IPv6' && !iface.internal && !iface.address.startsWith('fe80')) {
                ipv6Addresses.push(iface.address);
            }
        }
    }

    return {
        ipv4: ipv4Addresses.length > 0 ? ipv4Addresses[0] : 'No IPv4 address found',
        ipv6: ipv6Addresses.length > 0 ? ipv6Addresses[0] : 'No IPv6 address found',
        allIPv4: ipv4Addresses,
        allIPv6: ipv6Addresses
    };
}

// Set Host Data (Static at Command Load or using OS directly)
const username = os.userInfo().username;
const hostname = os.hostname();
const osType = os.type();
const osRelease = os.release();
const osArch = os.arch();
const hostUptimeSeconds = os.uptime();
const hostDays = Math.floor(hostUptimeSeconds / (60 * 60 * 24));
const hostHours = Math.floor((hostUptimeSeconds % (60 * 60 * 24)) / (60 * 60));
const hostMinutes = Math.floor((hostUptimeSeconds % (60 * 60)) / 60);
const cpuModel = os.cpus()[0]?.model || 'Unknown CPU Model';
const cpuCores = os.cpus().length;
const { ipv4: hostIPv4, ipv6: hostIPv6 } = getLocalIPAddresses();
const program_ver = "1.0.0";

/**
 * The hexfetch command source code.
 */
export const hexfetch = {
    description: 'Displays system information and Hexley core statistics in a neofetch style.',
    extendedDescription: 'The hexfetch command gathers hardware, network, and Hexley process metrics for system debugging.',
    
    async main(Hexley: any, args: string[]) {
        
        // Host System Data
        const { aurora, registry } = Hexley.frameworks;
        const mem = await si.mem();
        const totalMemoryGB = formatMemory(mem.total);
        const usedMemoryGB = formatMemory(mem.used - mem.active);
        const gpuData = await si.graphics();
        const gpuModel = gpuData.controllers.length > 0 ? gpuData.controllers[0].model : 'No GPU Detected';
        const working_dir = process.cwd();
        const registryVersionString = String(Hexley.versions['registryFramework']?.version || 'N/A');
        const hexShellVersionString = String(Hexley.versions['hexShellFramework']?.version || 'N/A');
        const loaderVersion = String(Hexley.versions['loaderFramework']?.version || 'N/A');
        const allEntries = registry.getAllEntries();
        const allFrameworkEntries = allEntries.filter((entry: any) => entry.Type === 'Framework');
        const privateFrameworksCount = allFrameworkEntries.filter((entry: any) => entry['Framework Type'] === 'Private').length;
        const publicFrameworksCount = allFrameworkEntries.filter((entry: any) => entry['Framework Type'] === 'Public').length;
        const finalTotalFrameworks = String(allFrameworkEntries.length);
        const finalPrivateFrameworks = String(privateFrameworksCount);
        const finalPublicFrameworks = String(publicFrameworksCount);
        const finalLoadedModules = String(registry.getModulesCount());
        const finalTotalDrivers = String(registry.getDriversCount());
        const finalPrivateDrivers = String(registry.getPrivateDriversCount());
        const finalPublicDrivers = String(registry.getPublicDriversCount());
        
        // Kernel Data - This isn't future proof for when "micro" kernels are a thing, or multi-instancing is a thing
        let kernelName = 'Unknown Hexley';
        let kernelVersion = 'N/A';
        for (const name in Hexley.versions) {

            const entry = Hexley.versions[name];
            if (entry && entry.type === 'Kernel') {
                kernelName = name; // The key is the name
                kernelVersion = entry.version;
                break; // Stop once we find the first (primary) kernel
            }

        }

        // Discord Data
        let discordUptime = 'Discord Not Loaded';
        let deployedGuildInfo = 'N/A (Discord Not Loaded)';
        const discordClient = Hexley.frameworks.discord?.client;
        const discordGuild = Hexley.frameworks.discord?.guild;

        if (Hexley.resources.framework.discord.isLoaded && discordClient && discordGuild) {
            // Client Uptime Data
            if (discordClient.uptime !== undefined) {
                const uptimeInMs = discordClient.uptime;
                const uptimeInSeconds = Math.floor(uptimeInMs / 1000);
                const uptimeInMinutes = Math.floor(uptimeInSeconds / 60);
                const uptimeInHours = Math.floor(uptimeInMinutes / 60); 
                const uptimeInDays = Math.floor(uptimeInHours / 24);
                const remainingHours = uptimeInHours % 24;
                const remainingMinutes = uptimeInMinutes % 60;
                const remainingSeconds = uptimeInSeconds % 60;
                
                discordUptime = `${uptimeInDays} days, ${remainingHours} hours, ${remainingMinutes} minutes, ${remainingSeconds} seconds`;
            }

            // Guild Info
            if (discordGuild.name && discordGuild.id) {
                 deployedGuildInfo = `${discordGuild.name} (${discordGuild.id})`;
            } else {
                 deployedGuildInfo = 'Discord Loaded (Guild Unresolved)';
            }
        }

        const h = aurora.tintRedBright;
        const c = aurora.colorText;
        const g = aurora.tintGray;
        const dividerLine = c('-'.repeat(username.length + hostname.length + 1), g);

        console.log('');
        console.log(c('                                                    ', h));
        console.log(c('            +x                                      ', h));
        console.log(`${c('        Xx x++X xxX', h)}${c('          x+++                   ', g)}${c(`        ${username}@${hostname}`, h)}`);
        console.log(`${c('       +++X++;+$+;+x', h)}${c('    x+++++++++++++x             ', g)}${c(`        ${dividerLine}`, h)}`);
        console.log(`${c('       +++X x+$ xx++', h)}${c('   X;;;;;+++;++;;;;++           ', g)}${c(`        Host:`, h)}${c(` ${osType} ${osRelease} ${osArch}`, g)}`);
        console.log(`${c('      x++   x+X   X;+', h)}${c('  $;;+x;;;;;;++;;;;;+X         ', g)}${c(`        System Uptime:`, h)}${c(` ${hostDays} days, ${hostHours} hours, ${hostMinutes} minutes`, g)}`);
        console.log(`${c('      x++   x+x    ++X', h)}${c('  x;+;:::;+x;;+;;;;;+X x      ', g)}${c(`        System Memory:`, h)}${c(` ${usedMemoryGB} GB / ${totalMemoryGB} GB`, g)}`);
        console.log(`${c('      x++X  x;+   x;+X', h)}${c('  x:.;:::.:;;;;+;;++;;;;+     ', g)}${c(`        CPU:`, h)}${c(` ${cpuModel} (${cpuCores} cores)`, g)}`);
        console.log(`${c('       ++;+++;;+++;+xX', h)}${c('+;;++:;..  .;;;;;++;;;;+      ', g)}${c(`        GPU:`, h)}${c(` ${gpuModel}`, g)}`);
        console.log(`${c('         +x+++;+xxX', h)}${c('$+x;;;x+;+.. xx;;;;;;;++xx       ', g)}${c(`        Hexley at:`, h)}${c(` ${working_dir}`, g)}`);
        console.log(`${c('             x;x', h)}${c('    $X+;;;;;; .;+;;+;;;;;;+$        ', g)}${c(`        Local IPv4 Address:`, h)}${c(` ${hostIPv4}`, g)}`);
        console.log(`${c('             x;+', h)}${c('      &x;;;;;;+++;;;;;;;+x          ', g)}${c(`        Local IPv6 Address:`, h)}${c(` ${hostIPv6}`, g)}`);
        console.log(`${c('             x;+', h)}${c('        $+++x::+x;+;;++X            ', g)}${c(`        ${kernelName} Version:`, h)}${c(` ${kernelVersion}`, g)}`);
        console.log(`${c('             $;+$', h)}${c('       +:::+++xX;+;;+              ', g)}${c(`        The Registry Version:`, h)}${c(` ${registryVersionString}`, g)}`);
        console.log(`${c('             X', g)}${c('+++;', h)}${c(';x+;:: .  :::::xx+;++             ', g)}${c(`        Loader Version:`, h)}${c(` ${loaderVersion}`, g)}`);
        console.log(`${c('             X', g)}${c('+++;', h)}${c(';x+;:: .  :::::xx+;++             ', g)}${c(`        hexShell Version:`, h)}${c(` ${hexShellVersionString}`, g)}`);
        console.log(`${c('              +++;', h)}${c(':::::.    :;;:::;+                ', g)}${c(`        hexFetch Version:`, h)}${c(` ${program_ver}`, g)}`);
        console.log(`${c('              x;++', h)}${c(';:::.     .:;+;::;+               ', g)}${c(`        Loaded Frameworks:`, h)}${c(` ${finalTotalFrameworks}`, g)}`);
        console.log(`${c('              x;+', h)}${c('  $X.  .    ::;;;;;+               ', g)}${c(`         - Private:`, h)}${c(` ${finalPrivateFrameworks}`, g)}`);
        console.log(`${c('              x;+$', h)}${c('  ;.       .::;+x$                ', g)}${c(`         - Public:`, h)}${c(` ${finalPublicFrameworks}`, g)}`);
        console.log(`${c('              x;+X', h)}${c('  X. . . ...:::;+                 ', g)}${c(`        Loaded Modules:`, h)}${c(` ${finalLoadedModules}`, g)}`);
        console.log(`${c('              x++x', h)}${c('  x;.   .  .;:::;X                ', g)}${c(`        Loaded Drivers:`, h)}${c(` ${finalTotalDrivers}`, g)}`);
        console.log(`${c('              x+++', h)}${c(' $::;.. ..;::::;+ X+Xx++xX        ', g)}${c(`         - Private:`, h)}${c(` ${finalPrivateDrivers}`, g)}`);
        console.log(`${c('               +;+', h)}${c('$X+;;;;::;::::;;++;;:::;;+&       ', g)}${c(`         - Public:`, h)}${c(` ${finalPublicDrivers}`, g)}`);
        console.log(`${c('               +;+', h)}${c('+++;;;++x+;;;;:x+++++++x          ', g)}${c(`        Discord Client Uptime:`, h)}${c(` ${discordUptime}`, g)}`);
        console.log(`${c('               xxXXXXX   x+x++x++$                  ', g)}${c(`        Currently Deployed at:`, h)}${c(` ${deployedGuildInfo}`, g)}`);
        console.log(c('                           X$x+xX                   ', g));
        console.log(c('                                                    ', g));
        console.log('');
    }
    
};
