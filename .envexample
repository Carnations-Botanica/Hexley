# Hexley Variables
DEBUG_MODE = FALSE
BUILD_TYPE = RELEASE
AURORA_ENABLED = TRUE
DISCORD_ENABLED = FALSE
DATABASE_ENABLED = TRUE
# DATABASE_MODE = Sequelizer
DATABASE_MODE = Local
HEXSHELL_ENABLED = TRUE

# Discord.JS Variables
DISCORD_TOKEN = exampleToken
GUILD_ID = exampleGuildId

# Hexley Endpoint Variables
SERVER_HOSTNAME = 0.0.0.0
ENDPOINT_PORT = 443
ENABLE_HTTPS = TRUE
HTTPS_CERT_PATH = /path/to/fullchain1.pem
HTTPS_KEY_PATH= /path/to/privkey1.pem

# Hexley Authentication Variables
AUTHENTICATION_AUTO = FALSE
AUTHENTICATION_USER = root
AUTHENTICATION_PASSWORD = password

# Hexley Session Variables
SESSION_AUTORUN_BUD = 
SESSION_AUTORUN_ARGS = 

# Sequelizer Variables
DB_NAME = HexleyBrain
DB_USER = root
DB_PASS = example
DB_HOST = localhost
DB_PORT = 3306

